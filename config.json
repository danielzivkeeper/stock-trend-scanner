      "senate_url": "https://senate-stock-watcher-data.s3-us-west-2.amazonaws.com/aggregate/all_transactions.json"
    },
    "social_spike": {
      "min_zscore": 2.0,
      "full_strength_multiple": 2.0,
      "use_wikipedia": true,
      "wikipedia_lookback_days": 60,
      "wikipedia_baseline_window": 28,
      "use_google_trends": true,
      "trends_timeframe": "today 3-m",
      "trends_baseline_window": 28,
      "trends_pause_seconds": 5,
      "reddit_subreddits": ["wallstreetbets", "stocks", "investing", "smallstreetbets"],
      "reddit_lookback_days": 30,
      "reddit_baseline_window": 21
    }
  },
  "movers_top_n": 15,
  "daily_summary": {
    "_help": "End-of-day text (evening scan only): S&P 500 stocks that fell drop_threshold_pct or more today, alerts, top scores, trending names.",
    "enabled": true,
